# Copy to `.env` at the repository root (or inject via your process manager).
# Never commit real secrets.

# --- HTTP API ---
# Used by smoke scripts and external callers.
# NER_SERVICE_URL=http://127.0.0.1:8000

# --- TypeDB (optional; required for POST /schema-pipeline/raw and /formatted) ---
# These variables must be present in the **same environment as the uvicorn / ASGI process**.
# Having them only in a client app (e.g. GrooveGraph) is not enough: the FastAPI server reads them here.
#
# TYPEDB_CONNECTION_STRING=
# TYPEDB_ADDRESSES=
# TYPEDB_USERNAME=
# TYPEDB_PASSWORD=
# TYPEDB_DATABASE=
